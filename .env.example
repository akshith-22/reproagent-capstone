# Optional overrides. The runnable baseline defaults to local Ollama and needs
# no API key. Copy this file to .env only if you want to change these values.
AGENT_PROVIDER=ollama
OLLAMA_MODEL=qwen3:1.7b

# Optional hosted alternative (requires credits):
# AGENT_PROVIDER=openai
# OPENAI_API_KEY=replace_with_your_key
# OPENAI_MODEL=gpt-5-mini
